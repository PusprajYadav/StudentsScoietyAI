    "@capacitor/status-bar": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@heroicons/react": "^2.2.0",
    "@libpdf/core": "^0.3.4",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.101.1",
    "axios": "^1.14.0",
    "date-fns": "^4.1.0",
