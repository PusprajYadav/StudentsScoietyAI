{
  "name": "student-society",
  "private": true,
  "version": "1.0.229",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "dev:native": "node scripts/run-vite-native-dev.mjs",
    "dev:native:force": "node scripts/run-vite-native-dev.mjs --force",
    "dev:backend": "cd ../backend && venv/bin/uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "build": "vite build",
    "lint": "eslint .",
    "bugfix:generate-bank": "node scripts/generateBugFixQuestionBank.mjs",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:build": "vite build && npx cap sync",
    "android:clean": "cd android && ./gradlew clean",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:release": "vite build && npx cap sync android && cd android && ./gradlew clean bundleRelease assembleRelease",
    "cap:repair:ios": "bash scripts/repair-ios-spm.sh",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android:live": "node scripts/run-capacitor-live.mjs android",
    "cap:run:ios:live": "node scripts/run-capacitor-live.mjs ios"
  },
  "dependencies": {
