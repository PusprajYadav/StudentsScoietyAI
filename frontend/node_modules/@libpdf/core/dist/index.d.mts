   * @param subsetFonts - Whether to subset fonts (only include used glyphs)
   */
  finalize(subsetFonts: boolean): void;
  /**
   * @deprecated Use `finalize()` instead. This method exists for backwards compatibility.
   */
  prepare(): void;
}
